# Environment Configuration Example
# Copy this file to .env and fill in your API keys

# ============================================
# OpenRouter Configuration
# ============================================
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ============================================
# Native API Configuration (Optional)
# ============================================

# OpenAI
OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=https://api.openai.com/v1

# Vision model for fengshui-photo / landscape-photo image recognition.
# Optional. If omitted, the app returns editable mock recognition results.
# Supported: openai/openrouter/qiniu with an OpenAI-compatible vision model.
# Qiniu tested option:
# VISION_PROVIDER=qiniu
# VISION_MODEL=qwen-vl-max-2025-01-25
# VISION_API_KEY=your_qiniu_ai_api_key
# VISION_BASE_URL=https://api.qnaigc.com/v1
#
# OpenAI example:
# VISION_PROVIDER=openai
# VISION_MODEL=gpt-4o-mini
# VISION_API_KEY=your_openai_or_openrouter_api_key
# VISION_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google
GOOGLE_API_KEY=your_google_api_key
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1

# DeepSeek
DEEPSEEK_API_KEY=sk-31a3cf87c65b4b638e6dc7d764789f65
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Doubao / ByteDance
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_BASE_URL=your_doubao_base_url
DOUBAO_ENDPOINT_ID=your_doubao_endpoint_id

# ============================================
# Performance Settings
# ============================================
TIMEOUT=60000
MAX_TOKENS=81920
TEMPERATURE=0.0
